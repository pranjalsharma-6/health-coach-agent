# Copy to backend/.env and fill in real values. Never commit .env.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=KayaDB

# --- Auth ---
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM ---
# Groq is free and fast — get a key at https://console.groq.com
GROQ_API_KEY=
# Optional fallback.
OPENAI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.4
# Caps how many output tokens each call may reserve. Leave blank unless you hit
# a 413: providers count reserved output against your per-minute limit, so a
# tight free tier needs a smaller number here. Try 1500.
# LLM_MAX_TOKENS=1500
# For reasoning models (gpt-oss, qwen3). They spend output tokens thinking
# before answering, which on a tight rate limit can leave nothing for the
# answer itself — seen as "tool_use_failed" with an empty generation.
# low | medium | high
# LLM_REASONING_EFFORT=low
# How structured output is requested. The default asks the model to call a
# tool. If you keep seeing "tool_use_failed", switch to json_mode, which asks
# for raw JSON and sidesteps tool calling entirely.
# function_calling | json_mode
# LLM_STRUCTURED_METHOD=json_mode

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
