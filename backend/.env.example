# Copy to backend/.env and fill in real values. Never commit .env.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=KayaDB

# --- Auth ---
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM ---
# Pick ONE provider by setting its key. Leave LLM_PROVIDER blank and whichever
# key is present is used; set it explicitly if you have more than one.
# groq | gemini | openai
LLM_PROVIDER=

# Free, and by far the most generous daily allowance:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free and very fast, but a small daily token budget:
# https://console.groq.com
GROQ_API_KEY=
# Optional fallback.
OPENAI_API_KEY=
# Model names are provider-specific. Leave blank for the provider's default;
# `python -m app.tools.check_llm` lists what your key can actually reach.
LLM_MODEL=
LLM_TEMPERATURE=0.4
# Caps how many output tokens each call may reserve. Leave blank unless you hit
# a 413: providers count reserved output against your per-minute limit, so a
# tight free tier needs a smaller number here. Try 1500.
# LLM_MAX_TOKENS=1500
# For reasoning models (gpt-oss, qwen3). They spend output tokens thinking
# before answering, which on a tight rate limit can leave nothing for the
# answer itself — seen as "tool_use_failed" with an empty generation.
# low | medium | high
# LLM_REASONING_EFFORT=low
# How structured output is requested. The default asks the model to call a
# tool. If you keep seeing "tool_use_failed", switch to json_mode, which asks
# for raw JSON and sidesteps tool calling entirely.
# function_calling | json_mode
# Ignored on Gemini, which has only one structured-output path.
# LLM_STRUCTURED_METHOD=json_mode

# --- Planning ---
# Days per generated plan. A 7-day plan costs about 7500 tokens and an 8000
# tokens-per-minute free tier leaves no room to retry, so the default is 4.
# Raise it if your provider's limit allows.
PLAN_DURATION_DAYS=4

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
