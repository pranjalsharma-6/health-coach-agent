# Copy to backend/.env and fill in real values. Never commit .env.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=KayaDB

# --- Auth ---
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM ---
# Pick ONE provider by setting its key. Leave LLM_PROVIDER blank and whichever
# key is present is used; set it explicitly if you have more than one.
# groq | gemini | openai
LLM_PROVIDER=

# Free, but the free tier is metered in *requests* per day, not tokens, and one
# plan run costs several. Fine for occasional use, tight for development.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free, very fast, and metered in tokens per day — which suits this workload
# better. The recommended starting point.
# https://console.groq.com
GROQ_API_KEY=
# Optional fallback.
OPENAI_API_KEY=

# Model names are provider-specific and are NOT interchangeable: a Gemini name
# left here while GROQ_API_KEY is the active key is sent to Groq and refused.
# Leave it blank for the provider's default — that is the right answer unless
# you have a reason. `python -m app.tools.check_llm` lists what your key can
# actually reach, and the API refuses to start a plan on a mismatched pair.
LLM_MODEL=
LLM_TEMPERATURE=0.4
# A hard ceiling on what each call may reserve. Leave it blank — the budget
# sizes itself from your plan length and meals per day, and a ceiling below
# what a plan needs does not save tokens, it truncates the plan mid-week. Set
# it only if your provider's per-minute limit is tighter than Groq's free tier,
# and the API will tell you at startup if the number is too low to work.
# LLM_MAX_TOKENS=
# For reasoning models (gpt-oss, qwen3). They spend output tokens thinking
# before answering, out of the same budget as the answer. The budget now
# reserves room for both, so this is a way to spend fewer tokens per run, not
# a fix for anything.
# low | medium | high
LLM_REASONING_EFFORT=low
# How structured output is requested. The default asks the model to call a
# tool. If you keep seeing "tool_use_failed", switch to json_mode, which asks
# for raw JSON and sidesteps tool calling entirely.
# function_calling | json_mode
# Ignored on Gemini, which has only one structured-output path.
# LLM_STRUCTURED_METHOD=json_mode

# --- Planning ---
# Days per generated plan. A 7-day plan costs about 7500 tokens and an 8000
# tokens-per-minute free tier leaves no room to retry, so the default is 4.
# Raise it if your provider's limit allows.
PLAN_DURATION_DAYS=4

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
